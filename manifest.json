{
  "manifest_version": 3,
  "name": "AI Task Automator",
  "version": "2.0.0",
  "description": "Automate any website with natural language commands powered by AI",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Task Automator"
  },
  "background": {
    "service_worker": "background.js"
  }
}
